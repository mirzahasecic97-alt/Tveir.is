{
  "redirects": [
    {
      "source": "/:slod*",
      "has": [
        {
          "type": "host",
          "value": "www.tveir.is"
        }
      ],
      "destination": "https://tveir.is/:slod*",
      "permanent": true
    },
    {
      "source": "/vignir-vatnar.html",
      "destination": "/vignir/",
      "permanent": false
    },
    {
      "source": "/vignir-vatnar",
      "destination": "/vignir/",
      "permanent": false
    },
    {
      "source": "/kerfi.html",
      "destination": "/thjonusta.html",
      "permanent": false
    },
    {
      "source": "/kerfi",
      "destination": "/thjonusta.html",
      "permanent": false
    },
    {
      "source": "/glerhusid",
      "destination": "https://glerhusid.vercel.app/",
      "permanent": false
    },
    {
      "source": "/glerhusid/:slod*",
      "destination": "https://glerhusid.vercel.app/:slod*",
      "permanent": false
    },
    {
      "source": "/vinnusvaedi",
      "destination": "/glerhus/kerfi/",
      "permanent": false
    },
    {
      "source": "/vinnusvaedi/",
      "destination": "/glerhus/kerfi/",
      "permanent": false
    },
    {
      "source": "/vinnusvaedi/:slod*",
      "destination": "/glerhus/kerfi/:slod*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/glerhus/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:slod*",
      "has": [
        {
          "type": "host",
          "value": "eminkadri.tveir.is"
        }
      ],
      "destination": "/emin/:slod*"
    },
    {
      "source": "/:slod*",
      "has": [
        {
          "type": "host",
          "value": "vignirvatnar.tveir.is"
        }
      ],
      "destination": "/vignir/:slod*"
    }
  ]
}
